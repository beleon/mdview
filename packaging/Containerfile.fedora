# Build environment for the .rpm: the same build as the top-level
# Containerfile, but against Fedora's libraries, so the package links what
# Fedora actually ships. Built on the oldest Fedora still supported; the
# result runs there and on every newer release.
FROM docker.io/library/fedora:43
RUN dnf -y install --setopt=install_weak_deps=False \
        gcc-c++ cmake make pkgconf-pkg-config \
        wayland-devel wayland-protocols-devel libxkbcommon-devel \
        cairo-devel pango-devel gdk-pixbuf2-devel \
        rpm-build binutils \
    && dnf clean all
WORKDIR /build
COPY CMakeLists.txt /build/mdview/
COPY src/ /build/mdview/src/
COPY protocol/ /build/mdview/protocol/
COPY thirdparty/ /build/mdview/thirdparty/
RUN cmake -S /build/mdview -B /build/mdview/build -DCMAKE_BUILD_TYPE=Release
RUN cmake --build /build/mdview/build --config Release -- -j"$(nproc)"
